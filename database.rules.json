{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$sessionId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['id', 'createdAt'])",
        "id": {
          ".validate": "newData.isString() && newData.val() === $sessionId"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "users": {
          "$userId": {
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            }
          }
        }
      }
    }
  }
}
